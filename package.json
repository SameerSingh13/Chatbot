{
  "name": "chatbot",
  "version": "1.0.0",
  "description": "AI/ML QA Automation Framework for Chatbot",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:debug": "cross-env TEST_ENV=qa playwright test --ui",
    "test:uiopen": "cross-env TEST_ENV=qa playwright test --headed",
    "test:ui": "cross-env TEST_ENV=qa playwright test tests/ui",
    "test:ai": "cross-env TEST_ENV=qa playwright test tests/ai",
    "test:ground-truth": "cross-env TEST_ENV=qa playwright test --grep @ground-truth",
    "test:security": "cross-env TEST_ENV=qa playwright test tests/security",
    "report": "playwright show-report reports/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  }
}
